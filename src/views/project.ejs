<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>
            <a class="edit-link" href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        </p>
        <h2>
            <%= project.title %>
        </h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

<!-- Volunteer Section -->

        <% if (isLoggedIn) { %>

            <% if (!userIsVolunteer) { %>

                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit">
                        Volunteer for this Project
                    </button>
                </form>

                <% } else { %>
                    <p>
                        You are volunteering for this project.
                    </p>

                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit">
                            Stop Volunteering
                        </button>
                    </form>

            <% } %>

        <% } %>


<!-- End of Section -->
    </main>

    <%- include('partials/footer') %>