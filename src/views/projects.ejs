<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Explore upcoming service opportunities in your community.</p>

        <% if (!projects || projects.length===0) { %>
            <p>No projects found at this time. Please check back later.</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <strong>
                                <%= new Date(project.project_date).toLocaleDateString("en-US", { year: "numeric" ,
                                    month: "long" , day: "numeric" }) %>
                            </strong>
                            : <%= project.title %>
                                (<%= project.organization_name %>)
                        </li>
                        <% }) %>
                </ul>
                <% } %>
    </main>
    <%- include('partials/footer') %>