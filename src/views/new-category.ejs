    <%- include('partials/header') %>

<main>
    <h1>Add New Category</h1>

    <form action="/new-category" method="POST">

        <label for="categoryName">
            Category Name
        </label>

        <input
            type="text"
            id="categoryName"
            name="categoryName"
            required
            maxlength="100"
        >

        <button type="submit">
            Create Category
        </button>

    </form>
</main>

<%- include('partials/footer') %>