<%- include('partials/header') %>

    <main>

        <h1>
            <%= category.category_name %>
        </h1>

        <h2>Projects in this Category</h2>

        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
                <% }) %>
        </ul>
        <p>
            <a class="edit-link" href="/edit-category/<%= category.category_id %>">
                Edit Category
            </a>
        </p>
        
    </main>

    <%- include('partials/footer')%>