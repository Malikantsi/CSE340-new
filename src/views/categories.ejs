<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Explore our service project categories.</p>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.category_name %>
                </a>
            </li>
        <% }) %>
    </ul>
    
</main>

<%- include('partials/footer') %>